# Postgres connection string. DATABASE_URI also works (see payload.config.ts).
DATABASE_URL=postgres://payload:CHANGE_ME@payload-db:5432/payload

# Generate with: openssl rand -base64 32
PAYLOAD_SECRET=

# Public URL the CMS is served on, via the Cloudflare tunnel.
PAYLOAD_PUBLIC_SERVER_URL=https://cms.avsworks.be

# Public site. Used for CORS/CSRF and as the target for revalidation pings.
FRONTEND_URL=https://avsworks.be

# Shared secret for POSTing to FRONTEND_URL/api/revalidate on content changes.
# Must match REVALIDATE_SECRET in the web app.
REVALIDATE_SECRET=
