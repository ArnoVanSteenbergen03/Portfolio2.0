# Base URL of the Payload CMS.
#
#   Production:  https://cms.avsworks.be     (via the Cloudflare tunnel)
#   Local dev:   http://the-adinator:3005    (straight to the Pi over Tailscale)
#
# Note the Pi publishes Payload on 3005, not 3001 — 3001 is Uptime Kuma.
NEXT_PUBLIC_CMS_URL=https://cms.avsworks.be

# Shared secret for POST /api/revalidate. Must match REVALIDATE_SECRET in the
# payload-cms container so its afterChange hooks can push content live.
# Generate with: openssl rand -base64 32
REVALIDATE_SECRET=
